import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import GridSearchCV
from sklearn.metrics import classification_report
from sklearn.feature_selection import RFE
from sklearn.preprocessing import StandardScaler
from imblearn.under_sampling import RandomUnderSampler
import joblib

# Charger votre ensemble de données
df = pd.read_csv('df_pre_processed.csv', low_memory=False)

# Étapes de prétraitement
df['grav'] = df['grav'].replace({1: 0, 2: 1, 3: 1, 4: 1})
df = df.sort_values(by='grav')
df = df.drop_duplicates(subset='Num_Acc', keep='last')
df = df.drop(columns=['num_veh'])
df['date'] = pd.to_datetime(df.date)
df['dayoftheyear'] = df['date'].dt.dayofyear
df = pd.concat([df, pd.get_dummies(df['date'].dt.day_name(), prefix='jour')], axis=1)
df['heure'] = (df['date'].dt.hour + df['date'].dt.minute / 60.0).astype(float)

# Définir X et y
data = df.drop(columns=['grav', 'date', 'Num_Acc'])
target = df['grav']

# Diviser les données en ensembles d'entraînement et de test (vous aviez deux divisions, j'en ai supprimé une)
X_train, X_test, y_train, y_test = train_test_split(data, target, test_size=0.3, stratify=target, random_state=723)

# Standardiser les caractéristiques numériques
scaler = StandardScaler()
X_train[['age', 'dayoftheyear', 'heure']] = scaler.fit_transform(X_train[['age', 'dayoftheyear', 'heure']])
X_test[['age', 'dayoftheyear', 'heure']] = scaler.transform(X_test[['age', 'dayoftheyear', 'heure']])

# Sous-échantillonnage pour gérer le déséquilibre des classes
rus = RandomUnderSampler()
X_train, y_train = rus.fit_resample(X_train, y_train)

# Définir la plage de nombres de caractéristiques à vérifier
feature_numbers = list(range(10, 90, 10))

# Initialiser un dictionnaire pour stocker les résultats
results = {}

# Parcourir différents nombres de caractéristiques
for num_features_to_select in feature_numbers:
    # Créer et ajuster le modèle RFE
    estimateur = LogisticRegression(max_iter=1000)
    rfe = RFE(estimateur, n_features_to_select=num_features_to_select)
    X_train_selected = rfe.fit_transform(X_train, y_train)

    # Effectuer une recherche d'hyperparamètres avec validation croisée
    param_grid = {
        'C': [0.001, 0.01, 0.1, 1, 10],
        'penalty': ['l2', 'l1', 'elasticnet'],
        'solver': ['liblinear', 'lbfgs', 'sag', 'saga']
    }
    grid_search = GridSearchCV(LogisticRegression(max_iter=1000), param_grid, cv=5, scoring='accuracy')
    grid_search.fit(X_train_selected, y_train)
    best_params = grid_search.best_params_

    # Créer et entraîner le modèle final avec les meilleurs hyperparamètres
    final_lr_model = LogisticRegression(max_iter=1000, **best_params)
    final_lr_model.fit(X_train_selected, y_train)

    # Transformer les données de test
    X_test_selected = rfe.transform(X_test)

    # Faire des prédictions et calculer les métriques
    y_pred = final_lr_model.predict(X_test_selected)
    rapport_classification = classification_report(y_test, y_pred)

    # Stocker les résultats dans le dictionnaire
    results[num_features_to_select] = {
        'meilleurs_params': best_params,
        'rapport_classification': rapport_classification,
        'modèle': final_lr_model
    }

# Trouver le nombre de caractéristiques qui a donné la meilleure précision
meilleur_nombre_caracteristiques = max(results, key=lambda x: results[x]['modèle'].score(X_test_selected, y_test))
meilleur_resultat = results[meilleur_nombre_caracteristiques]

# Afficher les résultats pour le meilleur nombre de caractéristiques
print(f"Meilleur Nombre de Caractéristiques: {meilleur_nombre_caracteristiques}")
print("Meilleurs Hyperparamètres:", meilleur_resultat['meilleurs_params'])
print("Rapport de Classification:\n", meilleur_resultat['rapport_classification'])

# Enregistrer le meilleur modèle avec Joblib
joblib.dump(meilleur_resultat['modèle'], "modele_rl_RFE.pkl")
